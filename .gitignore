# secrets — never commit.
.secrets/
*.env

# runtime / user data (auto-seeded on first run)
phoenix-config.json
workflows.json
palette.json
library-labels.json

# generated / runtime dirs
output/
staging/
session/
logs/
brushes/
animations/
custom-rigs/
characters/

# Blender working files. Scenes, rescues and WIP saves are hundreds of MB and belong to the
# artist, not to the project. No .blend ships: the addon is .py, the workflows are .json.
scenes/
*.blend
*.blend1

# One-off session scratch under scripts/ (shipped helpers live in scripts/<topic>/)
scripts/session-*

# OS / editor / node
.DS_Store
node_modules/
*.log

# Python cache (Blender addon)
__pycache__/
*.pyc

# Troubleshooting live state (ship the template, not per-issue state files)
troubleshooting/active/*
!troubleshooting/active/_TEMPLATE.md

# Editor/session backups
*.bak
*.bak-*

# Claude working instructions (references the local dev tree — machine path, never ships)
CLAUDE.md
